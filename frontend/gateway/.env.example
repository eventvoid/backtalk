# Gateway config for local dev (`npm run dev`). For Docker, see the repo-root .env.
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://backtalk:backtalk@localhost:5432/backtalk
PUBLIC_BASE_URL=
TRUST_PROXY=false

# Secrets — set real values. Never commit real tokens.
ADMIN_TOKEN=change-me-admin
NODE_TOKEN=change-me-node

# Node health / routing
NODE_OFFLINE_MS=60000
NODE_REQUEST_TIMEOUT_MS=300000

# Feedback (A/B) sampling rate for web assistant requests
FEEDBACK_RATE=0.3
FEEDBACK_IGNORE_PENALTY=0.02

# Optional per-caller limit overrides; defaults live in src/config.ts
# OPENAI_RPM=30
# NATIVE_ACTIVE=1
