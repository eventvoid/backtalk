{
  "name": "backtalk-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "BackTalk frontend + API gateway: UI, routing/load-balancing across backend nodes, auth, limits, dataset logging.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate.ts up",
    "migrate:reset": "tsx src/migrate.ts reset"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.9.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
