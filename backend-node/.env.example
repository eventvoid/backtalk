# Backend node config. The gateway may be on a public/static-IP server.
GATEWAY_URL=https://gateway.example.com
NODE_TOKEN=change-me-node          # must match the gateway's NODE_TOKEN
NODE_NAME=node-1
NODE_TRANSPORT=pull                # outbound polling; no inbound port required
NODE_POLL_WAIT_MS=30000
NODE_EVENT_BATCH_MS=100          # max transport delay; events remain real model output
DEVICE=auto                        # auto | cpu | cuda | mps
NODE_MAX_CONCURRENCY=1

# Only needed if the model files are NOT already present locally:
# MODEL_SOURCE=/abs/path/to/repo            # local dir (or MinIO/S3 mount) to copy from
# MODEL_SOURCE=https://example.com/backtalk # http(s) base to download <rel>/model.pt from
