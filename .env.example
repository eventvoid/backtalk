# Copy to .env and fill in the sections needed by the commands you run.
# Dataset generation only:
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Gateway + node stack (docker compose) ---------------------------------
# Secrets are read from env only and never logged.
POSTGRES_USER=backtalk
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=backtalk

ADMIN_TOKEN=change-me-admin      # required to open /dashboard
NODE_TOKEN=change-me-node        # backend nodes authenticate with this
PUBLIC_BASE_URL=                 # production example: https://backtalk.example.com
TRUST_PROXY=false                # true only when direct access bypassing the proxy is blocked

# Local compose override only (Coolify does not need these):
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080

FEEDBACK_RATE=0.3                # share of web Ask requests that get A/B feedback
FEEDBACK_IGNORE_PENALTY=0.02
NODE_OFFLINE_MS=60000
NODE_REQUEST_TIMEOUT_MS=300000   # idle timeout; allows cold accelerator startup

# Per-caller rate limits.
WEB_ACTIVE=1
WEB_RPS=1
WEB_RPM=10
WEB_RPH=100
WEB_RPD=500
NATIVE_ACTIVE=2
NATIVE_RPS=2
NATIVE_RPM=30
NATIVE_RPH=500
NATIVE_RPD=5000
OPENAI_ACTIVE=4
OPENAI_RPS=4
OPENAI_RPM=120
OPENAI_RPH=3000
OPENAI_RPD=30000
